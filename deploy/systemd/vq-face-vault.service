[Unit]
Description=VENTUNO Q consent-gated encrypted Face Vault
After=basic.target

[Service]
Type=simple
WorkingDirectory=%h/vq-platform
Environment=PYTHONPATH=%h/vq-platform
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m face_vault_service.service
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/vq-platform/face-vault %h/.config/vq-platform/secrets %t
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
