[Unit]
Description=VENTUNO Q bounded system and hardware telemetry
After=basic.target

[Service]
Type=simple
WorkingDirectory=/home/arduino/vq-platform
ExecStart=/usr/bin/python3 -m telemetry_service.service --interval 5
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/user/1000
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
TasksMax=32
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
