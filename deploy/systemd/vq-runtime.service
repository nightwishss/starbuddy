[Unit]
Description=VENTUNO Q Capability Runtime

[Service]
Type=simple
WorkingDirectory=/home/arduino/vq-platform
ExecStart=/usr/bin/python3 -m runtime.service
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/arduino /run/user/1000
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=VQ_TTS_BACKEND=melo

[Install]
WantedBy=default.target
